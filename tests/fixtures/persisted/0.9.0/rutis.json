{
  "id": "main",
  "runtimes": {
    "node": { "project": ".", "runtime": "vendor/rutis-runtime" },
    "py": { "project": "plugins", "python": "python3" },
    "bun": { "project": "edge", "runtime": "vendor/rutis-bun", "program": "tools/bun" },
    "go": { "dir": "plugins/go", "binaries": ["bin/netkit"], "start": "on-demand", "idle": 30, "project": "work" }
  },
  "listen": [
    { "name": "public", "address": "0.0.0.0:7443", "cert": "tls/server.pem", "key": "tls/server.key" },
    { "name": "local", "address": "127.0.0.1:7444" }
  ],
  "rows": [
    { "id": "weather", "name": "weather-plugin", "config": { "city": "Oslo" }, "inject": ["llm"], "isolate": { "cache": true } },
    { "id": "llm", "name": "py:llm_gateway", "isolate": { "http": "shared" } },
    { "id": "edge-fn", "name": "bun:edge_fn" },
    { "id": "dns", "name": "go:dns" },
    { "id": "local-tool", "name": "./tools/tool.ts" },
    { "id": "old-tool", "name": "../shared/old-tool.mjs", "disabled": true },
    { "id": "tools", "group": true, "config": [
      { "id": "tool-a", "name": "./tools/a.ts", "config": { "level": 2 } },
      { "id": "tool-b", "name": "tool-b-plugin", "disabled": false }
    ] },
    { "id": "per-session", "group": true, "instanced": true, "config": [
      { "id": "session-state", "name": "session-state-plugin" }
    ] },
    { "id": "embedder", "name": "gpu:embedder" },
    { "id": "edge-dns", "name": "edge-go:dns" }
  ]
}
