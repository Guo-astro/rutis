{
  "format": 1,
  "id": "edge-host",
  "runtimes": {
    "node": {
      "project": "<dir>",
      "restart": "on-failure"
    },
    "py": {
      "project": "<dir>",
      "python": "<dir>/.venv/bin/python",
      "restart": "exit"
    },
    "bun": {
      "project": "<dir>/edge"
    },
    "go": {
      "binaries": [
        "<dir>/bin/netkit",
        "<dir>/bin/dns"
      ],
      "start": "eager",
      "project": "<dir>",
      "restart": "on-failure"
    },
    "swift": {
      "binaries": [
        "<dir>/bin/MacKit"
      ],
      "start": "on-demand",
      "idle": 120,
      "project": "<dir>",
      "restart": "exit"
    },
    "remote": [
      {
        "name": "gpu",
        "language": "python"
      },
      {
        "name": "office-node",
        "language": "node"
      },
      {
        "name": "edge-bun",
        "language": "bun"
      },
      {
        "name": "phone",
        "language": "python",
        "listen": "public",
        "instances": "phones"
      },
      {
        "name": "kiosk",
        "language": "bun",
        "listen": "public",
        "instances": "kiosks"
      },
      {
        "name": "iphone",
        "language": "swift",
        "listen": "public",
        "instances": "iphones"
      },
      {
        "name": "android",
        "language": "kotlin",
        "listen": "public",
        "instances": "androids"
      },
      {
        "name": "tablet",
        "language": "kt"
      }
    ]
  },
  "listen": [
    {
      "name": "public",
      "address": "[::]:7443",
      "cert": "<dir>/../tls/server.pem",
      "key": "<dir>/../tls/server.key"
    }
  ],
  "rows": [
    {
      "id": "weather",
      "name": "weather-plugin",
      "config": {
        "city": "Oslo",
        "units": [
          "metric"
        ]
      },
      "inject": [
        "llm",
        "cache"
      ]
    },
    {
      "id": "llm",
      "name": "py:llm_gateway",
      "isolate": {
        "http": true
      }
    },
    {
      "id": "edge-fn",
      "name": "bun:./fn/edge.ts"
    },
    {
      "id": "dns",
      "name": "go-dns:resolver"
    },
    {
      "id": "probe",
      "name": "go:probe",
      "disabled": true
    },
    {
      "id": "local-tool",
      "name": "file://<dir>/tools/tool.ts"
    },
    {
      "id": "tools",
      "group": true,
      "config": [
        {
          "id": "tool-a",
          "name": "./tools/a.ts"
        },
        {
          "id": "nested",
          "group": true,
          "config": [
            {
              "id": "tool-c",
              "name": "../shared/c.mjs"
            }
          ]
        }
      ]
    },
    {
      "id": "per-session",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "session-state",
          "name": "session-state-plugin"
        }
      ]
    },
    {
      "id": "office",
      "name": "rutis-bridge/peer",
      "config": {
        "peer": "office",
        "dial": "wss://office.example.com/rutis",
        "export": [
          "weather",
          "order/*"
        ],
        "import": [
          "stock/changed"
        ],
        "runtime": "office-node",
        "transport": "websocket",
        "identity": "host"
      }
    },
    {
      "id": "branch",
      "name": "rutis-bridge/peer",
      "config": {
        "peer": "branch",
        "listen": "public",
        "transport": "websocket",
        "identity": "edge"
      }
    },
    {
      "id": "gpu",
      "name": "rutis-bridge/peer",
      "config": {
        "peer": "gpu",
        "dial": "wss://gpu.example.com/rutis",
        "runtime": "gpu",
        "transport": "websocket",
        "identity": "host"
      }
    },
    {
      "id": "embedder",
      "name": "gpu:embedder"
    },
    {
      "id": "clock",
      "name": "peer:office/clock"
    },
    {
      "id": "edge-bun",
      "name": "rutis-bridge/peer",
      "config": {
        "peer": "edge-bun",
        "dial": "wss://edge.example.com/rutis",
        "runtime": "edge-bun",
        "transport": "websocket",
        "identity": "host"
      }
    },
    {
      "id": "render",
      "name": "edge-bun:render"
    },
    {
      "id": "phones",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "camera",
          "name": "phone:camera"
        }
      ]
    },
    {
      "id": "kiosks",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "screen",
          "name": "kiosk:screen"
        }
      ]
    },
    {
      "id": "clipboard",
      "name": "swift-MacKit:clipboard"
    },
    {
      "id": "iphones",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "contacts",
          "name": "iphone:contacts"
        }
      ]
    },
    {
      "id": "androids",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "notify",
          "name": "android:notify"
        }
      ]
    },
    {
      "id": "tablet",
      "name": "rutis-bridge/peer",
      "config": {
        "peer": "tablet",
        "dial": "wss://tablet.local:7443/rutis",
        "runtime": "tablet",
        "transport": "websocket",
        "identity": "host"
      }
    },
    {
      "id": "device",
      "name": "tablet:device"
    }
  ]
}
