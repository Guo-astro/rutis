{
  "format": 1,
  "id": "edge-host",
  "runtimes": {
    "node": {
      "project": "<dir>",
      "restart": "on-failure"
    },
    "py": {
      "project": "<dir>",
      "python": "<dir>/.venv/bin/python",
      "restart": "exit"
    },
    "bun": {
      "project": "<dir>/edge"
    },
    "go": {
      "binaries": [
        "<dir>/bin/netkit",
        "<dir>/bin/dns"
      ],
      "start": "eager",
      "project": "<dir>",
      "restart": "on-failure"
    },
    "swift": {
      "binaries": [
        "<dir>/bin/MacKit"
      ],
      "start": "on-demand",
      "idle": 120,
      "project": "<dir>",
      "restart": "exit"
    }
  },
  "listen": [
    {
      "name": "public",
      "address": "[::]:7443",
      "cert": "<dir>/../tls/server.pem",
      "key": "<dir>/../tls/server.key"
    }
  ],
  "rows": [
    {
      "id": "weather",
      "name": "weather-plugin",
      "config": {
        "city": "Oslo",
        "units": [
          "metric"
        ]
      },
      "inject": [
        "llm",
        "cache"
      ]
    },
    {
      "id": "llm",
      "name": "py:llm_gateway",
      "isolate": {
        "http": true
      }
    },
    {
      "id": "edge-fn",
      "name": "bun:./fn/edge.ts"
    },
    {
      "id": "probe",
      "name": "go:probe",
      "disabled": true
    },
    {
      "id": "local-tool",
      "name": "file://<dir>/tools/tool.ts"
    },
    {
      "id": "tools",
      "group": true,
      "config": [
        {
          "id": "tool-a",
          "name": "./tools/a.ts"
        },
        {
          "id": "nested",
          "group": true,
          "config": [
            {
              "id": "tool-c",
              "name": "../shared/c.mjs"
            }
          ]
        }
      ]
    },
    {
      "id": "per-session",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "session-state",
          "name": "session-state-plugin"
        }
      ]
    },
    {
      "id": "embedder",
      "name": "gpu:embedder"
    },
    {
      "id": "render",
      "name": "edge-bun:render"
    },
    {
      "id": "phones",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "camera",
          "name": "phone:camera"
        }
      ]
    },
    {
      "id": "kiosks",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "screen",
          "name": "kiosk:screen"
        }
      ]
    },
    {
      "id": "iphones",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "contacts",
          "name": "iphone:contacts"
        }
      ]
    },
    {
      "id": "androids",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "notify",
          "name": "android:notify"
        }
      ]
    },
    {
      "id": "device",
      "name": "tablet:device"
    }
  ]
}
