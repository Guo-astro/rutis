{
  "format": 1,
  "id": "edge-host",
  "runtimes": {
    "node": {
      "project": "<dir>"
    },
    "py": {
      "project": "<dir>",
      "python": "<dir>/.venv/bin/python"
    },
    "bun": {
      "project": "<dir>/edge"
    },
    "go": {
      "binaries": [
        "<dir>/bin/netkit",
        "<dir>/bin/dns"
      ],
      "start": "eager",
      "project": "<dir>"
    }
  },
  "listen": [
    {
      "name": "public",
      "address": "[::]:7443",
      "cert": "<dir>/../tls/server.pem",
      "key": "<dir>/../tls/server.key"
    }
  ],
  "rows": [
    {
      "id": "weather",
      "name": "weather-plugin",
      "config": {
        "city": "Oslo",
        "units": [
          "metric"
        ]
      },
      "inject": [
        "llm",
        "cache"
      ]
    },
    {
      "id": "llm",
      "name": "py:llm_gateway",
      "isolate": {
        "http": true
      }
    },
    {
      "id": "edge-fn",
      "name": "bun:./fn/edge.ts"
    },
    {
      "id": "probe",
      "name": "go:probe",
      "disabled": true
    },
    {
      "id": "local-tool",
      "name": "file://<dir>/tools/tool.ts"
    },
    {
      "id": "tools",
      "group": true,
      "config": [
        {
          "id": "tool-a",
          "name": "./tools/a.ts"
        },
        {
          "id": "nested",
          "group": true,
          "config": [
            {
              "id": "tool-c",
              "name": "../shared/c.mjs"
            }
          ]
        }
      ]
    },
    {
      "id": "per-session",
      "group": true,
      "instanced": true,
      "config": [
        {
          "id": "session-state",
          "name": "session-state-plugin"
        }
      ]
    },
    {
      "id": "office",
      "name": "rutis-bridge/peer",
      "config": {
        "peer": "office",
        "dial": "wss://office.example.com/rutis",
        "export": [
          "weather"
        ],
        "identity": "host"
      }
    },
    {
      "id": "branch",
      "name": "rutis-bridge/peer",
      "config": {
        "peer": "branch",
        "listen": "public",
        "identity": "edge"
      }
    },
    {
      "id": "gpu",
      "name": "rutis-bridge/peer",
      "config": {
        "peer": "gpu",
        "dial": "wss://gpu.example.com/rutis",
        "identity": "host"
      }
    },
    {
      "id": "embedder",
      "name": "gpu:embedder"
    },
    {
      "id": "clock",
      "name": "peer:office/clock"
    }
  ]
}
