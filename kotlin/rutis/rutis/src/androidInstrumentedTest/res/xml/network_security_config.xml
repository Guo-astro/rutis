<?xml version="1.0" encoding="utf-8"?>
<!-- The test CA (raw/system_ca) is trusted as the system's CAs are; a
     <domain-config> makes Android's system trust refuse checks that do not
     say which host they are for (TrustTest). -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/system_ca" />
        </trust-anchors>
    </base-config>
    <domain-config>
        <domain includeSubdomains="true">example.invalid</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
