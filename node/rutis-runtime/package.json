    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "pyright": "1.1.414"
  }
}
