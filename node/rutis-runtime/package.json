{
  "name": "@arcships/rutis-runtime",
  "version": "0.19.0",
  "description": "The Node runtime of rutis: runs JavaScript and TypeScript plugins (and Cordis plugins) for a rutis host",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcships/rutis.git",
    "directory": "node/rutis-runtime"
  },
  "homepage": "https://github.com/arcships/rutis/tree/main/node/rutis-runtime#readme",
  "keywords": [
    "rutis",
    "cordis",
    "plugin",
    "runtime"
  ],
  "rutisProtocol": 4,
  "rutisChannels": [
    "unix",
    "fd"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "src"
