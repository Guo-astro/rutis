{
  "name": "{{name}}",
  "version": "0.1.0",
  "description": "A rutis plugin",
  "keywords": ["rutis-plugin"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "bun test",
    "dev": "rutis-host dev",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@arcships/rutis": "^{{version}}"
  },
  "devDependencies": {
    "@arcships/rutis-bun": "^{{version}}",
    "@arcships/rutis-host": "^{{version}}",
    "@types/bun": "^1.2.0",
    "typescript": "^6.0.0"
  }
}
